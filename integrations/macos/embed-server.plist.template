<?xml version="1.0" encoding="UTF-8"?>
<!-- Template for the resident embedding server LaunchAgent. Do not install this
     file directly — run integrations/macos/install.sh, which substitutes
     __VAULT__ and __PYTHON__, writes the result to ~/Library/LaunchAgents/,
     and loads it with launchctl. macOS only. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.llm-wiki.embed-server</string>
  <key>ProgramArguments</key><array>
    <string>__PYTHON__</string>
    <string>__VAULT__/integrations/macos/embed_server.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/wiki-embed-server.log</string>
  <key>StandardErrorPath</key><string>/tmp/wiki-embed-server.log</string>
</dict></plist>
